# book 项目 Apache 配置
RewriteEngine On
AddDefaultCharset UTF-8
Options -Indexes

# ---------- 安全响应头 ----------
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; object-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
    Header always unset X-Powered-By
</IfModule>

# ---------- 隐藏敏感文件 ----------
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
<Files "config.php">
    Require all denied
</Files>
<FilesMatch "\.(sql|env|ini|log|bak|md|pdf)$">
    Require all denied
</FilesMatch>

# ---------- 禁止直接访问数据目录（只能通过 PHP 入口读取） ----------
RewriteRule ^(MARKDOWN|PDFS)(/.*)?$ - [F,L]

# ---------- 强制 HTTPS（启用 SSL 后取消注释） ----------
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ---------- 路由 ----------
DirectoryIndex index.php

# 文件中心
RewriteRule ^files/?$ files.php [L]

# 搜索
RewriteRule ^search/?$ RELESEAS/search.php [L]

# 下载代理（PDF 经过登录校验）
RewriteRule ^download/([^/]+)/([^/]+)/?$ download.php?dir=$1&file=$2 [L,QSA]

# 美化 Markdown URL：/目录名/文件名 -> index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([^/]+)/([^/]+)/?$ index.php?dir=$1&file=$2 [L,QSA]

# 去掉末尾斜杠
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# ---------- 静态资源缓存 ----------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/font-woff2 "access plus 1 month"
    ExpiresByType application/font-woff "access plus 1 month"
    ExpiresByType application/x-font-ttf "access plus 1 month"
</IfModule>

# ---------- Gzip 压缩 ----------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/json
</IfModule>

# ---------- PHP 上传限制 ----------
<IfModule mod_php7.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 10M
    php_value max_execution_time 300
    php_value max_input_time 300
    php_value memory_limit 128M
</IfModule>

# 404 错误页
ErrorDocument 404 "<h1>页面未找到</h1><p><a href='/'>返回首页</a></p>"
