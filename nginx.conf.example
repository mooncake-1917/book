# =============================================================
# book 项目 Nginx 配置示例
# 适用：Nginx + PHP-FPM（通用写法，不依赖发行版的 snippets）
# 兼容 Termux / Android（如 wstoolbox）等无 /etc/nginx 目录的环境
#
# 使用：将 server {} 内容合并到你的站点配置，替换 server_name、
#       root 与 PHP-FPM 监听地址后重载 nginx。
#       PHP-FPM 监听地址可能是：
#         unix:/var/run/php/php-fpm.sock
#         unix:/var/run/php/php8.1-fpm.sock
#         unix:/run/php-fpm/www.sock
#         127.0.0.1:9000
#       请按实际环境修改。
# =============================================================

server {
    listen 80;
    server_name localhost;

    root /data/data/com.xiaojiangi.wstoolbox/extensions/nginx/html/book;
    index index.php;

    # 上传大小限制（与 PHP upload_max_filesize 保持一致）
    client_max_body_size 10m;
    autoindex off;

    # ---------- 安全响应头 ----------
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; object-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'" always;

    # ---------- 隐藏敏感文件 ----------
    location ~ /\. { deny all; }
    location ~ \.(sql|env|ini|log|bak)$ { deny all; }
    location = /config.php { deny all; }

    # ---------- 禁止直接访问数据目录（只能通过 PHP 入口读取） ----------
    location ^~ /MARKDOWN/ { deny all; }
    location ^~ /PDFS/     { deny all; }

    # ---------- TOOLS：仅允许 AJAX 接口直接访问 ----------
    location = /TOOLS/GET_ITEMS.php  { include fastcgi_params; fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name; fastcgi_pass 127.0.0.1:9000; }
    location = /TOOLS/GET_SEARCH.php { include fastcgi_params; fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name; fastcgi_pass 127.0.0.1:9000; }
    location = /TOOLS/GET_MD.php     { include fastcgi_params; fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name; fastcgi_pass 127.0.0.1:9000; }
    location ^~ /TOOLS/ { deny all; }

    # ---------- 路由 ----------
    location = / {
        try_files $uri /index.php?$query_string;
    }

    location = /files {
        try_files $uri /files.php?$query_string;
    }
    location ~ ^/files/ {
        try_files $uri $uri/ /files.php?$query_string;
    }

    location ~ ^/search/?$ {
        try_files $uri /RELESEAS/search.php?$query_string;
    }

    # PDF 下载代理（可选）
    location ~ ^/download/([^/]+)/([^/]+)/?$ {
        rewrite ^/download/([^/]+)/([^/]+)/?$ /download.php?dir=$1&file=$2 last;
    }

    # ---------- PHP（通用写法，不依赖 snippets） ----------
    location ~ \.php$ {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_pass 127.0.0.1:9000;   # 按实际 PHP-FPM 监听地址修改
    }

    # ---------- 静态资源缓存 ----------
    location ~* \.(jpg|jpeg|gif|png|webp|svg|css|js|woff2?|ttf)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # ---------- 美化 Markdown URL：/目录名/文件名 -> index.php ----------
    location ~ ^/[^/]+/[^/]+/?$ {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # ---------- Gzip ----------
    gzip on;
    gzip_types text/plain text/css application/javascript application/json application/xml image/svg+xml;
    gzip_min_length 1024;
}
