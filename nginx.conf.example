# =============================================================
# book 项目 Nginx 配置示例
# 适用：Nginx + PHP-FPM
# 使用：将 server {} 内容按需合并到你的站点配置，替换域名、
#       root 和 PHP-FPM socket 后重载 nginx。
# =============================================================

server {
    listen 80;
    server_name your-domain.com;

    root /var/www/book;
    index index.php;

    # 上传大小限制（与 PHP upload_max_filesize 保持一致）
    client_max_body_size 10m;
    autoindex off;

    # ---------- 安全响应头 ----------
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; object-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'" always;

    # ---------- 隐藏敏感文件 ----------
    location ~ /\. { deny all; }
    location ~ \.(sql|env|ini|log|bak)$ { deny all; }
    location = /config.php { deny all; }

    # ---------- 禁止直接访问数据目录（只能通过 PHP 入口读取） ----------
    location ^~ /MARKDOWN/ { deny all; }
    location ^~ /PDFS/     { deny all; }

    # ---------- TOOLS：仅允许 AJAX 接口直接访问 ----------
    location = /TOOLS/GET_ITEMS.php  { include snippets/fastcgi-php.conf; fastcgi_pass unix:/var/run/php/php8.1-fpm.sock; }
    location = /TOOLS/GET_SEARCH.php { include snippets/fastcgi-php.conf; fastcgi_pass unix:/var/run/php/php8.1-fpm.sock; }
    location = /TOOLS/GET_MD.php     { include snippets/fastcgi-php.conf; fastcgi_pass unix:/var/run/php/php8.1-fpm.sock; }
    location ^~ /TOOLS/ { deny all; }

    # ---------- 路由 ----------
    location = / {
        try_files $uri /index.php?$query_string;
    }

    location = /files {
        try_files $uri /files.php?$query_string;
    }
    location ~ ^/files/ {
        try_files $uri $uri/ /files.php?$query_string;
    }

    location ~ ^/search/?$ {
        try_files $uri /RELESEAS/search.php?$query_string;
    }

    # PDF 下载代理（可选；项目当前使用 /download.php?dir=&file=）
    location ~ ^/download/([^/]+)/([^/]+)/?$ {
        rewrite ^/download/([^/]+)/([^/]+)/?$ /download.php?dir=$1&file=$2 last;
    }

    # ---------- PHP ----------
    # 注意：snippets/fastcgi-php.conf 为 Debian/Ubuntu 路径；
    # 其他发行版可改为 include fastcgi_params; 并手动设置 SCRIPT_FILENAME。
    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/var/run/php/php8.1-fpm.sock; # 按实际 PHP-FPM socket 修改
    }

    # ---------- 静态资源缓存 ----------
    location ~* \.(jpg|jpeg|gif|png|webp|svg|css|js|woff2?|ttf)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # ---------- 美化 Markdown URL：/目录名/文件名 -> index.php ----------
    # 放在其他规则之后，避免吞掉 .php / 静态资源请求
    location ~ ^/[^/]+/[^/]+/?$ {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # ---------- Gzip ----------
    gzip on;
    gzip_types text/plain text/css application/javascript application/json application/xml image/svg+xml;
    gzip_min_length 1024;
}
